<section class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-6">Pesanan Saya</h1>

  <% if (transactions.length === 0) { %>
    <div class="bg-white border border-gray-100 rounded-xl p-10 text-center text-gray-400">
      Anda belum memiliki pesanan. <a href="/destinations" class="text-green-800 font-medium hover:underline">Cari destinasi</a>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% transactions.forEach(function(t) { %>
        <% const statusClass = t.status === 'paid'
          ? 'bg-green-100 text-green-700'
          : t.status === 'pending'
            ? 'bg-yellow-100 text-yellow-700'
            : 'bg-red-100 text-red-700'; %>
        <% const statusLabel = t.status === 'paid'
          ? 'LUNAS'
          : t.status === 'pending'
            ? 'MENUNGGU'
            : 'DIBATALKAN'; %>
        <div class="bg-white border border-gray-100 rounded-xl p-5 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
          <div class="flex items-center gap-4">
            <img src="<%= t.Ticket.Destination.image || 'https://images.unsplash.com/photo-1596402184320-417e7178b2cd?w=200' %>" class="w-20 h-20 object-cover rounded-lg" alt="<%= t.Ticket.Destination.name %>" />
            <div>
              <p class="font-semibold"><%= t.Ticket.Destination.name %></p>
              <p class="text-xs text-gray-400">Kode: TRX-<%= String(t.id).padStart(6,'0') %></p>
              <p class="text-xs text-gray-500 mt-1"><%= t.Ticket.name %> · <%= t.quantity %> tiket · <%= new Date(t.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            </div>
          </div>
          <div class="text-right w-full md:w-auto">
            <p class="font-bold text-green-800"><%= t.formattedTotal %></p>
            <span class="inline-block mt-1 text-xs font-medium px-2 py-1 rounded-full <%= statusClass %>">
              <%= statusLabel %>
            </span>

            <% if (t.status === 'pending') { %>
              <div class="flex flex-col sm:flex-row gap-2 mt-3 justify-end">
                <form action="/user/my-orders/<%= t.id %>/pay" method="POST">
                  <button type="submit" class="w-full sm:w-auto bg-green-800 hover:bg-green-900 text-white text-xs font-medium px-4 py-2 rounded-lg">
                    Bayar
                  </button>
                </form>
                <form action="/user/my-orders/<%= t.id %>/cancel" method="POST">
                  <button type="submit" class="w-full sm:w-auto border border-red-300 text-red-600 hover:bg-red-50 text-xs font-medium px-4 py-2 rounded-lg">
                    Batalkan
                  </button>
                </form>
              </div>
            <% } else { %>
              <br/>
              <a href="/destinations/<%= t.Ticket.Destination.id %>" class="text-xs text-green-800 hover:underline">Lihat Destinasi</a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
