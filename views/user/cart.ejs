<section class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Keranjang Belanja</h1>
    <a href="/destinations" class="text-sm text-green-800 hover:underline">Lanjut Belanja</a>
  </div>

  <% if (!cart.items.length) { %>
    <div class="bg-white border border-gray-100 rounded-xl p-10 text-center">
      <p class="text-gray-500 mb-4">Keranjang Anda masih kosong.</p>
      <a href="/destinations" class="inline-block px-5 py-2.5 bg-green-800 text-white rounded-lg hover:bg-green-900 text-sm font-medium">
        Jelajahi Destinasi
      </a>
    </div>
  <% } else { %>
    <div id="cart-page" class="space-y-4">
      <% cart.items.forEach(function(item) { %>
        <div class="cart-item bg-white border border-gray-100 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-4" data-ticket-id="<%= item.ticketId %>">
          <div class="flex-1">
            <h2 class="font-semibold"><%= item.destinationName %></h2>
            <p class="text-sm text-gray-500"><%= item.ticketName %></p>
            <p class="text-sm text-green-800 font-medium mt-1">Rp<%= Number(item.price).toLocaleString('id-ID') %> / tiket</p>
          </div>

          <div class="flex items-center gap-3">
            <label class="text-xs text-gray-500">Jumlah</label>
            <input
              type="number"
              class="cart-qty w-20 border border-gray-200 rounded-lg px-2 py-1.5 text-sm"
              value="<%= item.quantity %>"
              min="1"
              max="<%= item.stock %>"
              data-ticket-id="<%= item.ticketId %>"
            />
          </div>

          <div class="text-right min-w-[120px]">
            <p class="text-xs text-gray-400">Subtotal</p>
            <p class="cart-subtotal font-bold text-green-800">Rp<%= Number(item.subtotal).toLocaleString('id-ID') %></p>
          </div>

          <button type="button" class="cart-remove text-red-500 hover:text-red-700 text-sm" data-ticket-id="<%= item.ticketId %>">
            Hapus
          </button>
        </div>
      <% }) %>

      <div class="bg-white border border-gray-100 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="text-sm text-gray-500">Total (<span id="cart-total-items"><%= cart.totalItems %></span> tiket)</p>
          <p id="cart-total-price" class="text-2xl font-bold text-green-800">Rp<%= Number(cart.totalPrice).toLocaleString('id-ID') %></p>
        </div>
        <form action="/user/cart/checkout" method="POST">
          <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-green-800 hover:bg-green-900 text-white font-medium rounded-lg">
            Bayar Sekarang
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <div id="cart-toast" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white text-sm px-4 py-3 rounded-lg shadow-lg z-50"></div>
</section>

<script src="/js/cart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.TiketopiaCart) {
      window.TiketopiaCart.initCartPage();
    }
  });
</script>
