<nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-green-800">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 20l6-11 4 7 3-5 5 9H3z" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      TIKETOPIA
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
      <a href="/" class="hover:text-green-700">Beranda</a>
      <a href="/destinations" class="hover:text-green-700">Destinasi</a>
      <a href="/destinations" class="hover:text-green-700">Provinsi</a>
      <% if (currentUser && currentUser.role === 'user') { %>
        <a href="/user/my-orders" class="hover:text-green-700">Pesanan Saya</a>
      <% } %>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin/dashboard" class="hover:text-green-700">Dashboard Admin</a>
      <% } %>
    </div>

    <div class="flex items-center gap-3">
      <% if (!currentUser) { %>
        <a href="/login" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-green-700">Masuk</a>
        <a href="/register" class="px-4 py-2 text-sm font-medium bg-green-800 text-white rounded-lg hover:bg-green-900">Daftar</a>
      <% } else { %>
        <% if (currentUser.role === 'user') { %>
          <a href="/user/cart" class="relative p-2 text-gray-600 hover:text-green-800" aria-label="Keranjang">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span id="cart-badge" class="absolute -top-1 -right-1 min-w-[1.25rem] h-5 px-1 bg-green-800 text-white text-xs font-bold rounded-full flex items-center justify-center <%= cartCount > 0 ? '' : 'hidden' %>">
              <%= cartCount %>
            </span>
          </a>
        <% } %>
        <a href="/user/profile" class="text-sm text-gray-600 hover:text-green-800">
          Halo, <strong><%= currentUser.username %></strong>
        </a>
        <form action="/logout" method="POST">
          <button type="submit" class="px-4 py-2 text-sm font-medium bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
            Keluar
          </button>
        </form>
      <% } %>
    </div>
  </div>
</nav>
