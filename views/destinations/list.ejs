<section class="max-w-7xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-2">Destinasi Wisata</h1>
  <p class="text-gray-500 text-sm mb-6">Temukan destinasi wisata impian Anda di seluruh Indonesia.</p>

  <form action="/destinations" method="GET" class="bg-white rounded-xl shadow-sm p-4 mb-6 flex flex-col md:flex-row gap-3 border border-gray-100">
    <select name="province" class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm">
      <option value="">Semua Provinsi</option>
      <% provinces.forEach(function(p) { %>
        <option value="<%= p.name %>" <%= selectedProvince === p.name ? 'selected' : '' %>><%= p.name %></option>
      <% }) %>
    </select>
    <input type="text" name="q" value="<%= query %>" placeholder="Cari nama destinasi..." class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm" />
    <select name="sort" class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm">
      <option value="name" <%= selectedSort === 'name' ? 'selected' : '' %>>Nama A–Z</option>
      <option value="name_desc" <%= selectedSort === 'name_desc' ? 'selected' : '' %>>Nama Z–A</option>
      <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>Terbaru</option>
      <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Harga terendah</option>
      <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Harga tertinggi</option>
    </select>
    <button type="submit" class="bg-green-800 hover:bg-green-900 text-white font-medium px-6 py-2 rounded-lg">Filter</button>
  </form>

  <% if (destinations.length === 0) { %>
    <p class="text-gray-500 text-center py-16">Tidak ada destinasi yang ditemukan.</p>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
      <% destinations.forEach(function(d) { %>
        <a href="/destinations/<%= d.id %>" class="block bg-white rounded-xl shadow-sm hover:shadow-md transition overflow-hidden border border-gray-100">
          <img src="<%= d.image || 'https://images.unsplash.com/photo-1596402184320-417e7178b2cd?w=600' %>" alt="<%= d.name %>" class="w-full h-36 object-cover" />
          <div class="p-3">
            <p class="text-xs text-green-700 font-medium"><%= d.Province ? d.Province.name : '-' %></p>
            <h3 class="font-semibold mt-1"><%= d.name %></h3>
            <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= d.description || '' %></p>
            <div class="mt-3 text-sm">
              <span class="text-gray-400 text-xs">Mulai dari</span><br/>
              <span class="font-bold text-green-800"><%= d.formattedStartingPrice %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<script src="/js/url-params.js"></script>
<script>
  TiketopiaUrlParams.canonicalizeCurrentUrl();
  TiketopiaUrlParams.bindDestinationFilterForm(
    document.querySelector('form[action="/destinations"]')
  );
</script>
