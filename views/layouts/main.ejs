<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Tiketopia</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-gray-50 text-gray-800">
  <%- include('../partials/navbar') %>

  <% if (typeof success !== 'undefined' && success.length > 0) { %>
    <div class="max-w-7xl mx-auto px-4 mt-4">
      <% success.forEach(function(msg) { %>
        <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-lg mb-2 text-sm">
          <%= msg %>
        </div>
      <% }) %>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="max-w-7xl mx-auto px-4 mt-4">
      <% error.forEach(function(msg) { %>
        <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-lg mb-2 text-sm">
          <%= msg %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
