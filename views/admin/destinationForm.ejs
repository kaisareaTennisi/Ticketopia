<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="flex flex-col md:flex-row gap-6">
    <%- include('../partials/adminSidebar', { active: 'destinations' }) %>

    <div class="flex-1 max-w-3xl">
      <h1 class="text-2xl font-bold mb-6"><%= destination ? 'Edit Destinasi' : 'Tambah Destinasi Baru' %></h1>

      <form action="<%= formAction %>" method="<%= formMethod %>" class="bg-white border border-gray-100 rounded-xl p-6 space-y-5">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="text-sm font-medium text-gray-700">Nama Destinasi</label>
            <input type="text" name="name" required value="<%= destination ? destination.name : '' %>" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
          </div>
          <div>
            <label class="text-sm font-medium text-gray-700">Provinsi</label>
            <input type="text" name="provinceName" required value="<%= destination && destination.Province ? destination.Province.name : '' %>" placeholder="contoh: Jawa Barat" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
          </div>
        </div>

        <div>
          <label class="text-sm font-medium text-gray-700">Deskripsi</label>
          <textarea name="description" rows="4" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm"><%= destination ? destination.description : '' %></textarea>
        </div>

        <div>
          <label class="text-sm font-medium text-gray-700">URL Gambar</label>
          <input type="text" name="image" value="<%= destination ? destination.image : '' %>" placeholder="https://..." class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
        </div>

        <% if (!destination) { %>
          <div class="border-t border-gray-100 pt-5">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Tiket Awal</h2>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-sm font-medium text-gray-700">Nama Tiket</label>
                <input type="text" name="ticketName" placeholder="Tiket Masuk Dewasa" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
              <div>
                <label class="text-sm font-medium text-gray-700">Harga Tiket (Rp)</label>
                <input type="number" name="ticketPrice" placeholder="100000" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
              <div>
                <label class="text-sm font-medium text-gray-700">Deskripsi Tiket</label>
                <input type="text" name="ticketDescription" placeholder="Tiket masuk untuk pengunjung dewasa" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
              <div>
                <label class="text-sm font-medium text-gray-700">Stok Tiket</label>
                <input type="number" name="ticketStock" value="100" min="1" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
            </div>
          </div>
        <% } %>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="bg-green-800 hover:bg-green-900 text-white font-medium px-6 py-2 rounded-lg">
            <%= destination ? 'Simpan Perubahan' : 'Tambahkan Destinasi' %>
          </button>
          <a href="/admin/destinations" class="text-gray-500 px-6 py-2 rounded-lg hover:bg-gray-50">Batal</a>
        </div>
      </form>
    </div>
  </div>
</section>
