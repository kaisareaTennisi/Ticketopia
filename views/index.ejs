<!-- Hero -->
<section class="relative hero-bg" style="background-image: linear-gradient(to right, rgba(0,0,0,0.55), rgba(0,0,0,0.15)), url('https://images.unsplash.com/photo-1589308454676-32d1c9e91a4b?w=1600');">
  <div class="max-w-7xl mx-auto px-4 py-24">
    <h1 class="text-4xl md:text-5xl font-bold text-white max-w-xl leading-tight">
      Jelajahi Keindahan Indonesia Bersama Tiketopia
    </h1>
    <p class="text-white/90 mt-4 max-w-md">
      Pesan tiket destinasi wisata terbaik dengan mudah dan aman.
    </p>

    <form action="/destinations" method="GET" class="bg-white rounded-xl shadow-lg p-4 mt-8 flex flex-col md:flex-row gap-3 max-w-3xl">
      <div class="flex-1">
        <label class="text-xs text-gray-500">Pilih Provinsi</label>
        <select name="province" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm">
          <option value="">Semua Provinsi</option>
          <% provinces.forEach(function(p) { %>
            <option value="<%= p.name %>"><%= p.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="flex-1">
        <label class="text-xs text-gray-500">Cari Destinasi</label>
        <input type="text" name="q" placeholder="Nama destinasi..." class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
      </div>
      <div class="flex items-end">
        <button type="submit" class="w-full md:w-auto bg-green-800 hover:bg-green-900 text-white font-medium px-6 py-2 rounded-lg mt-1">
          Cari Tiket
        </button>
      </div>
    </form>
  </div>
</section>

<script src="/js/url-params.js"></script>
<script>
  TiketopiaUrlParams.bindDestinationFilterForm(
    document.querySelector('form[action="/destinations"]')
  );
</script>

<!-- Trust badges -->
<section class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm text-gray-600">
  <div class="flex items-center gap-2"><span>🎫</span> 100% resmi &amp; terpercaya</div>
  <div class="flex items-center gap-2"><span>🔒</span> Transaksi aman &amp; terlindungi</div>
  <div class="flex items-center gap-2"><span>🎫</span> Tiket tersedia di pesanan</div>
  <div class="flex items-center gap-2"><span>🕐</span> Dukungan 24/7</div>
</section>

<!-- Destinasi populer -->
<section class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold">Destinasi Populer</h2>
    <a href="/destinations" class="text-sm text-green-800 font-medium hover:underline">Lihat Semua</a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
    <% destinations.forEach(function(d) { %>
      <a href="/destinations/<%= d.id %>" class="block bg-white rounded-xl shadow-sm hover:shadow-md transition overflow-hidden border border-gray-100">
        <img src="<%= d.image || 'https://images.unsplash.com/photo-1596402184320-417e7178b2cd?w=600' %>" alt="<%= d.name %>" class="w-full h-36 object-cover" />
        <div class="p-3">
          <p class="text-xs text-green-700 font-medium"><%= d.Province ? d.Province.name : '-' %></p>
          <h3 class="font-semibold mt-1"><%= d.name %></h3>
          <% if (d.avgRating) { %>
            <p class="text-xs text-yellow-600 mt-1">★ <%= d.avgRating %> (<%= d.reviewCount %> ulasan)</p>
          <% } %>
          <div class="flex items-center justify-between mt-3">
            <div class="text-sm">
              <span class="text-gray-400 text-xs">Mulai dari</span><br/>
              <span class="font-bold text-green-800"><%= d.formattedStartingPrice %></span>
            </div>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<!-- Destinasi berdasarkan provinsi -->
<section class="max-w-7xl mx-auto px-4 py-10">
  <h2 class="text-xl font-bold mb-4">Destinasi Berdasarkan Provinsi</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5">
    <% provinces.forEach(function(p) { %>
      <a href="/destinations?province=<%= encodeURIComponent(p.name) %>" class="rounded-xl overflow-hidden relative h-28 flex items-end group">
        <img src="<%= p.image || 'https://images.unsplash.com/photo-1518002171953-a080ee817e1f?w=400' %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition" alt="<%= p.name %>" />
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative p-3 text-white">
          <p class="font-semibold text-sm"><%= p.name %></p>
          <p class="text-xs text-white/80"><%= p.Destinations ? p.Destinations.length : 0 %> Destinasi</p>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<!-- Cara kerja -->
<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="bg-white rounded-xl shadow-sm p-8 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    <h3 class="md:col-span-3 font-bold text-lg mb-2">Cara Mudah Pesan Tiket di Tiketopia</h3>
    <div>
      <div class="text-3xl mb-2">🧭</div>
      <p class="font-semibold">Pilih Destinasi</p>
      <p class="text-sm text-gray-500">Pilih destinasi wisata favorit Anda</p>
    </div>
    <div>
      <div class="text-3xl mb-2">📅</div>
      <p class="font-semibold">Pilih Tanggal</p>
      <p class="text-sm text-gray-500">Tentukan tanggal kunjungan dan jumlah tiket</p>
    </div>
    <div>
      <div class="text-3xl mb-2">3️⃣</div>
      <p class="font-semibold">Bayar &amp; Dapatkan Tiket</p>
      <p class="text-sm text-gray-500">Lakukan pembayaran dan lihat tiket di halaman pesanan</p>
    </div>
  </div>
</section>
